# Courtly — example environment file. Copy to `.env` and fill real values.
# `.env` is gitignored; the real secrets are submitted as a password-protected zip (.env-tajne.zip).
# Loaded via DotNetEnv into strongly-typed options (feature 2). Nothing secret belongs in appsettings.json.
#
# Hosts below assume the containers. docker-compose.yml overrides the Postgres host -> `postgres` and
# RABBITMQ_HOST -> `rabbitmq` for the api/worker containers regardless, so for running them directly via
# `dotnet run` set the DB host / RABBITMQ_HOST to `localhost`.

# --- Database (PostgreSQL) — DB name must be exactly 200067 (rubric §3.1) ---
POSTGRES_DB=200067
POSTGRES_USER=courtly
POSTGRES_PASSWORD=change-me
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=200067;Username=courtly;Password=change-me

# --- JWT ---
JWT_KEY=change-me-to-a-32+character-random-secret
JWT_ISSUER=courtly
JWT_AUDIENCE=courtly
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_RESET_TOKEN_MINUTES=60

# --- Stripe (sandbox) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# ISO currency the server charges in (server owns the amount + currency — feature 16). Defaults to usd if unset.
STRIPE_CURRENCY=usd

# --- SMTP (email transport for the F22 reset link + F17 booking mail; driven entirely by .env) ---
#
# Option A — Mailpit (default): self-contained local catcher, no account needed. Captured mail is viewed
# at http://localhost:8025 (it is NOT delivered to real inboxes). In Docker the host is the `mailpit`
# service; for `dotnet run` use `localhost`.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@courtly.local
#
# Option B — real delivery to actual inboxes via Gmail. Requires 2-Step Verification on the Google account
# and a Gmail App Password (Google Account → Security → App passwords); the normal password is rejected.
# Replace the five values above with these (then `docker compose up -d` to recreate the containers):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_SSL=true            # STARTTLS on port 587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM=you@gmail.com      # Gmail requires From = the authenticated account

# --- RabbitMQ — use a dedicated user, NOT `guest` (guest is loopback-only and is refused across the Docker network) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=courtly
RABBITMQ_PASSWORD=change-me

# --- Reservations (feature 14) ---
# Minutes an unpaid Pending reservation holds its slot before it can be auto-cancelled (Worker scan, feature 17).
RESERVATION_HOLD_MINUTES=15
# How often (seconds) the Worker scans for expired holds to auto-cancel (feature 17).
RESERVATION_HOLD_SCAN_SECONDS=60

# --- API ---
API_BASE_URL=http://localhost:5000
# Shared secret the Worker uses to call the API's internal SignalR push endpoint (feature 18).
INTERNAL_PUSH_KEY=change-me-to-a-random-shared-secret
# CORS allow-list (feature 6) — comma-separated explicit origins; never a blanket allow-any (rubric §3.4).
# Native Flutter clients don't enforce CORS; this matters for the Flutter Web build / browser tools.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Password reset link (feature 22) ---
# Base URL of the browser password-reset page; the API appends ?email=…&token=…. Clicking the link in the
# email opens GET /reset-password (served by the API) where the user sets a new password. Use a host the
# email reader can reach: localhost works when the email is opened on the machine running the stack; for a
# phone on the same network use the machine's LAN IP (e.g. http://192.168.1.50:5000/reset-password).
APP_RESET_PASSWORD_URL=http://localhost:5000/reset-password
