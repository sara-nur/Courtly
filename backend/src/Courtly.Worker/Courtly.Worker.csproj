<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- RabbitMQ consumer, email sender, retry/backoff; calls API internal push endpoint. -->

  <ItemGroup>
    <!-- Worker SDK has no shared framework; the generic host types come from this package. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <!-- Feature 18: typed HttpClient (AddHttpClient) for the API internal SignalR push endpoint. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <!-- RabbitMQ broker connection (feature 2 baseline; full consumer in feature 17). -->
    <PackageReference Include="RabbitMQ.Client" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Courtly.Domain\Courtly.Domain.csproj" />
    <ProjectReference Include="..\Courtly.Contracts\Courtly.Contracts.csproj" />
    <ProjectReference Include="..\Courtly.Application\Courtly.Application.csproj" />
    <ProjectReference Include="..\Courtly.Infrastructure\Courtly.Infrastructure.csproj" />
  </ItemGroup>

</Project>
