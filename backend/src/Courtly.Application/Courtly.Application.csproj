    <!-- Feature 17: MailKit = real SMTP email sender (SmtpEmailSender, beside IEmailSender; Mailpit by default). -->
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Courtly.Domain\Courtly.Domain.csproj" />
